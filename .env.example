# =============================================================================
# ORCA Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to Git.

# ---------------------------------------------------------------------------
# Gemini AI
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# Inter-service URLs
# On Render each service gets its own public URL.
# For local development the default localhost values in the code are used.
# ---------------------------------------------------------------------------
OCEAN_API=http://localhost:8002
SAFETY_API=http://localhost:8003
ROUTE_API=http://localhost:8004
DECISION_API=http://localhost:8000
AUTH_API=http://localhost:8005

# ---------------------------------------------------------------------------
# CORS — set this to the deployed Cloudflare Workers frontend URL
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# On Render-hosted services, use the Internal Database URL when the
# database and service are in the same region.
# For local Alembic migrations, use the External Database URL.
# It will look like: postgresql://user:password@host:5432/dbname
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/orca_db

# ---------------------------------------------------------------------------
# JWT
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET=your_strong_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440