GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

OCEAN_API=http://localhost:8002
SAFETY_API=http://localhost:8003
ROUTE_API=http://localhost:8004
DECISION_API=http://localhost:8000
AUTH_API=http://localhost:8005

FRONTEND_URL=http://localhost:8080

# PostgreSQL — replace with your actual credentials
DATABASE_URL=postgresql://user:password@localhost:5432/orca_db

# JWT — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440