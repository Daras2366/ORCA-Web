# =============================================================================
# ORCA Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values before running:
#   npm run build
#
# IMPORTANT: VITE_* variables are baked into the JS bundle at build time.
# You MUST set them here and rebuild for changes to take effect.
# NEVER commit .env to Git.
#
# Deployment: Cloudflare Workers (npx wrangler deploy)
# These variables are NOT set in Cloudflare dashboard — they are build-time only.

# ---------------------------------------------------------------------------
# Query Agent URL (main backend — serves /query, /api/*, /transcribe, /synthesize)
# Local default: http://localhost:8001
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# Auth Agent URL (serves /auth/* and /vessels/*)
# Local default: http://localhost:8005
# ---------------------------------------------------------------------------
VITE_AUTH_API_URL=http://localhost:8005